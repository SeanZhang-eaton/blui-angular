{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "paths": {
      "@bldc/angular-components": ["./libs/@bldc/angular-components/src/public-api.ts"]
    },
    "lib": ["es2022", "dom"],
    "useDefineForClassFields": false,
    "rootDir": "."
  },
  "exclude": ["node_modules", "tmp"]
}
