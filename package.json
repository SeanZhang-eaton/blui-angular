{
  "name": "blui-angular",
  "version": "10.0.0",
  "description": "Angular components for Brightlayer UI applications",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "start:showcase": "nx serve showcase-demo --port 3200 --open",
    "start": "nx serve demo --port 3300 --open",
    "build": "pnpm run build:lib",
    "build:lib": "nx run-many --target=build  --projects='@bldc/angular-components,@bldc/angular-themes' -c production",
    "build:lib:themes": "nx build @bldc/angular-themes",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "nx format:check",
    "format:fix": "nx format:write",
    "test": "nx run-many --target=test --all",
    "test:ci": "pnpm run test --watch false",
    "test:demo": "nx test demo",
    "test:demo:ci": "pnpm run test:demo --watch false",
    "test:artifacts": "bash scripts/buildTest.sh",
    "coverage": "nx test demo --coverage",
    "changelog": "echo 'Changelog generation - implement as needed'",
    "release": "pnpx tsx -C import scripts/release.ts",
    "publish:package": "cd dist/libs/@bldc/angular-components && rm -f *.tgz && set npm_config_yes=true && npx -p @brightlayer-ui/publish blui-publish",
    "tag:package": "npx -p @brightlayer-ui/tag blui-tag -s -blui-angular-components",
    "precommit": "pnpm run lint && pnpm run test:ci && pnpm run build && pnpm run test:artifacts && pnpm run generate:licenses",
    "generate:licenses": "npm-license-crawler -onlyDirectDependencies -json LICENSES.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etn-ccis/blui-angular.git"
  },
  "keywords": [
    "angular",
    "components",
    "brightlayer-ui"
  ],
  "author": "brightlayer-ui <brightlayer-ui@eaton.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/etn-ccis/blui-angular/issues"
  },
  "homepage": "https://brightlayer-ui-components.github.io/angular",
  "dependencies": {
    "color": "^5.0.0",
    "style-observer": "0.1.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.9.7",
    "@analogjs/vitest-angular": "~2.9.7",
    "@angular-devkit/core": "~22.2.1",
    "@angular-devkit/schematics": "~22.2.1",
    "@angular/build": "~22.2.1",
    "@angular/cdk": "~22.3.0",
    "@angular/cli": "~22.2.1",
    "@angular/common": "~22.2.6",
    "@angular/compiler": "~22.2.6",
    "@angular/compiler-cli": "~22.2.6",
    "@angular/core": "~22.2.6",
    "@angular/forms": "~22.2.6",
    "@angular/material": "~22.3.0",
    "@angular/platform-browser": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@brightlayer-ui/colors": "~3.3.0",
    "@brightlayer-ui/icons": "~2.1.0",
    "@brightlayer-ui/icons-svg": "~1.11.0",
    "@fontsource/open-sans": "^5.2.5",
    "@hakimio/ngx-google-analytics": "~15.0.0",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "~22.2.1",
    "@types/node": "~22.19.2",
    "@types/prismjs": "~1.26.5",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "~5.1.1",
    "angular-eslint": "~22.7.0",
    "enquirer": "^2.4.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "~12.1.1",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "marked": "^18.2.1",
    "ng-packagr": "~22.3.0",
    "ngx-color-picker": "~20.1.1",
    "ngx-markdown": "~22.1.1",
    "nx": "24.0.6",
    "picocolors": "^1.1.1",
    "prettier": "~3.5.3",
    "prismjs": "~1.30.0",
    "rxjs": "~7.8.2",
    "sass": "^1.104.1",
    "semver": "^7.7.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "~5.1.1",
    "zone.js": "~0.16.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "nx"
    ],
    "overrides": {
      "@typescript-eslint/eslint-plugin": "^8.73.0",
      "@typescript-eslint/parser": "^8.73.0",
      "@typescript-eslint/type-utils": "^8.73.0",
      "@typescript-eslint/typescript-estree": "^8.73.0",
      "@typescript-eslint/utils": "^8.73.0"
    }
  }
}
