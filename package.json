{
  "name": "blui-angular",
  "version": "11.0.0",
  "description": "Angular components for Brightlayer UI applications",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "start:showcase": "nx serve showcase-demo --port 3200 --open",
    "start": "nx serve demo --port 3300 --open",
    "build": "pnpm run build:lib",
    "build:lib": "nx run-many --target=build  --projects='@bldc/angular-components,@bldc/angular-themes' -c production",
    "build:lib:themes": "nx build @bldc/angular-themes",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "nx format:check",
    "format:fix": "nx format:write",
    "test": "nx run-many --target=test --all",
    "test:ci": "nx run-many -t test",
    "test:demo": "nx test demo",
    "test:demo:ci": "nx test demo",
    "test:artifacts": "bash scripts/buildTest.sh",
    "coverage": "nx run-many -t test --coverage",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "pnpx tsx -C import scripts/release.ts",
    "precommit": "pnpm run lint && pnpm run test:ci && pnpm run build && pnpm run test:artifacts && pnpm run generate:licenses",
    "generate:licenses": "pnpx npm-license-crawler -onlyDirectDependencies -json LICENSES.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etn-ccis/blui-angular.git"
  },
  "keywords": [
    "angular",
    "components",
    "brightlayer-ui"
  ],
  "author": "brightlayer-ui <brightlayer-ui@eaton.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/etn-ccis/blui-angular/issues"
  },
  "homepage": "https://brightlayer-ui-components.github.io/angular",
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.9.7",
    "@analogjs/vitest-angular": "~2.9.7",
    "@angular-devkit/core": "~22.3.0",
    "@angular-devkit/schematics": "~22.3.0",
    "@angular/build": "~22.3.0",
    "@angular/cdk": "~22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/common": "~22.3.0",
    "@angular/compiler": "~22.3.0",
    "@angular/compiler-cli": "~22.3.0",
    "@angular/core": "~22.3.0",
    "@angular/forms": "~22.3.0",
    "@angular/material": "~22.3.0",
    "@angular/platform-browser": "~22.3.0",
    "@angular/router": "~22.3.0",
    "@brightlayer-ui/colors": "^3.3.0",
    "@brightlayer-ui/icons": "^2.7.0",
    "@brightlayer-ui/icons-svg": "^1.19.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/open-sans": "^5.3.0",
    "@hakimio/ngx-google-analytics": "~15.0.0",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "~22.3.0",
    "@types/node": "~22.19.2",
    "@types/prismjs": "~1.26.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "~5.1.1",
    "angular-eslint": "~22.8.0",
    "color": "^5.0.3",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "enquirer": "^2.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^21.0.4",
    "jsonc-eslint-parser": "^3.3.0",
    "marked": "^18.2.1",
    "ng-packagr": "~22.3.0",
    "ngx-color-picker": "~20.1.1",
    "ngx-markdown": "~22.1.1",
    "nx": "24.0.6",
    "picocolors": "^1.1.1",
    "prettier": "~3.10.1",
    "prismjs": "~1.30.0",
    "rxjs": "~7.8.2",
    "sass": "^1.104.1",
    "semver": "^7.8.6",
    "style-observer": "0.1.2",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "~5.1.1",
    "zone.js": "~0.16.3"
  }
}
