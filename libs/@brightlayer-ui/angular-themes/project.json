  "name": "@bldc/angular-themes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/@bldc/angular-themes/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
