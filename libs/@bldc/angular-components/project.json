{
  "name": "@bldc/angular-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/@bldc/angular-components/src",
  "prefix": "blui",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/@bldc/angular-components/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/@bldc/angular-components/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/@bldc/angular-components/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    }
  }
}
