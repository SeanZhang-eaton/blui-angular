{
  "name": "@bldc/angular-themes",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/@bldc/angular-themes/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/scripts/build-themes.mjs",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/LICENSES.json"
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "command": "node scripts/build-themes.mjs"
      }
    }
  }
}
